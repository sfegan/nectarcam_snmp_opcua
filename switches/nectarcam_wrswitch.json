{
  "host": ["10.11.4.25"],
  "community": "public",
  "description": "NectarCAM White Rabbit Switche",
  "opcua_path": "WRSwitch",
  "poll_interval": 10,
  "oids_per_get": 10,
  "oids": [
    {
      "oid": "SNMPv2-MIB::sysDescr.0",
      "opcua_name": "sysDescr",
      "opcua_type": "String",
      "description": "System description"
    },
    {
      "oid": "DISMAN-EVENT-MIB::sysUpTimeInstance",
      "opcua_name": "sysUpTime",
      "opcua_type": "String",
      "description": "System uptime"
    },
    {
      "oid": "SNMPv2-MIB::sysName.0",
      "opcua_name": "sysName",
      "opcua_type": "String",
      "description": "Administratively assigned system name"
    },
    {
      "oid": "IF-MIB::ifName.{1..20}", 
      "opcua_name": "ifName",
      "opcua_type": "String",
      "description": "Interface name"
    },
    {
      "oid": "IF-MIB::ifSpeed.{1..20}", 
      "opcua_name": "ifSpeed",
      "opcua_type": "UInt32",
      "description": "Interface speeds in bits per second"
    },
    {
      "oid": "IF-MIB::ifOperStatus.{1..20}", 
      "opcua_name": "ifOperStatus",
      "opcua_type": "Enum",
      "enum": {"1": "up", "2": "down", "3": "testing", "4": "unknown", "5": "dormant", "6": "notPresent", "7": "lowerLayerDown"},
      "description": "Operational state of the interfaces"
    },
    {
      "oid": "IF-MIB::ifInOctets.{1..20}", 
      "opcua_name": "ifHCInOctets",
      "opcua_type": "UInt64",
      "description": "Number of octets received on the interface"
    },
    {
      "oid": "IF-MIB::ifInDiscards.{1..20}", 
      "opcua_name": "ifInDiscards",
      "opcua_type": "UInt32",
      "description": "Number of inbound packets chosen to be discarded"
    },
    {
      "oid": "IF-MIB::ifInErrors.{1..20}", 
      "opcua_name": "ifInErrors",
      "opcua_type": "UInt32",
      "description": "Number of inbound packets with errors"
    },
    {
      "oid": "IF-MIB::ifOutOctets.{1..20}", 
      "opcua_name": "ifHCOutOctets",
      "opcua_type": "UInt64",
      "description": "Number of octets transmitted on the interface"
    },
    {
      "oid": "IF-MIB::ifOutDiscards.{1..20}", 
      "opcua_name": "ifOutDiscards",
      "opcua_type": "UInt32",
      "description": "Number of outbound packets chosen to be discarded"
    },
    {
      "oid": "IF-MIB::ifOutErrors.{1..20}", 
      "opcua_name": "ifOutErrors",
      "opcua_type": "UInt32",
      "description": "Number of outbound packets with errors"
    },
    {
      "oid": [ 
          "WR-SWITCH-MIB::wrsMainSystemStatus.0",
          "WR-SWITCH-MIB::wrsOSStatus.0",
          "WR-SWITCH-MIB::wrsTimingStatus.0",
          "WR-SWITCH-MIB::wrsNetworkingStatus.0"
        ],
      "opcua_name": "wrsGeneralStatus",
      "opcua_type": "Enum",
      "enum": {"0": "na", "1": "ok", "2": "error", "3": "warning", "4": "warningNA", "5": "bug"},
      "description": "General status of the White Rabbit Switch from the wrsGeneralStatusGroup. Elements are:\nwrsMainSystemStatus - Grouped status of WRS switch,\nwrsOSStatus - Grouped status of wrsOSStatusGroup,\nwrsTimingStatus - Grouped status of wrsTimingStatusGroup,\nwrsNetworkingStatus - Grouped status of wrsNetworkingStatusGroup"
    },
    {
      "oid": [ 
          "WR-SWITCH-MIB::wrsPTPStatus.0",
          "WR-SWITCH-MIB::wrsSoftPLLStatus.0",
          "WR-SWITCH-MIB::wrsSlaveLinksStatus.0",
          "WR-SWITCH-MIB::wrsPTPFramesFlowing.0",
          "WR-SWITCH-MIB::wrsSystemClockStatus.0"
        ],
      "opcua_name": "wrsTimingStatus",
      "opcua_type": "Enum",
      "enum": {"0": "na", "1": "ok", "2": "error", "3": "warning", "4": "warningNA", "5": "bug", "6": "firstRead"},
      "description": "Status of the timing system from the wrsTimingStatusGroup. Elements are:\nwrsPTPStatus - Grouped status of PTP daemon based on values in wrsPtpDataTable,\nwrsSoftPLLStatus - Grouped status of Soft PLL based on values in wrsSpllState,\nwrsSlaveLinksStatus - Grouped status of slave links,\nwrsPTPFramesFlowing - Grouped status of TX and RX PTP packets flowing,\nwrsSystemClockStatus - Grouped status of system clock"
    },
    {
      "oid": [ 
          "WR-SWITCH-MIB::wrsSFPsStatus.0",
          "WR-SWITCH-MIB::wrsEndpointStatus.0",
          "WR-SWITCH-MIB::wrsSwcoreStatus.0",
          "WR-SWITCH-MIB::wrsRTUStatus.0"
        ],
      "opcua_name": "wrsNetworkingStatus",
      "opcua_type": "Enum",
      "enum": {"0": "na", "1": "ok", "2": "error", "3": "warning", "4": "warningNA", "5": "bug", "6": "firstRead"},
      "description": "Status of the networking system from the wrsNetworkingStatusGroup. Elements are:\nwrsSFPsStatus - Grouped status of SFPs,\nwrsEndpointStatus - Grouped status of all endpoints,\nwrsSwcoreStatus - Overall status of Soft Core,\nwrsRTUStatus - RTU status"
    },
    {
      "oid": "WR-SWITCH-MIB::wrsVersionSwVersion.0",
      "opcua_name": "wrsVersionSwVersion",
      "opcua_type": "String",
      "description": "The software version, as returned from 'git describe' at build time"
    },
    {
      "oid": "WR-SWITCH-MIB::wrsVersionHwVersion.0",
      "opcua_name": "wrsVersionHwVersion",
      "opcua_type": "String",
      "description": "The hardware version, as returned from 'git describe' at build time"
    },
    {
      "oid": "WR-SWITCH-MIB::wrsDateTAI.0",
      "opcua_name": "wrsDateTAI",
      "opcua_type": "UInt64",
      "description": "The current TAI time in seconds since 1970-01-01 00:00:00"
    },
    {
      "oid": "WR-SWITCH-MIB::wrsDateTAIString.0",
      "opcua_name": "wrsDateTAIString",
      "opcua_type": "String",
      "description": "The current TAI time as a string in format YYYY-MM-DD-HH:MM:SS"
    },
    {
      "oid": "WR-SWITCH-MIB::wrsSystemClockStatusDetails.0",
      "opcua_name": "wrsSystemClockStatusDetails",
      "opcua_type": "Enum",
      "enum": {"0": "na", "1": "ok", "2": "thresholdExceeded", "3": "ntpError", "4": "error", "5": "ioError", "6": "unknownStatus"},
      "description": "The system clock is compared to NTP time"
    },
    {
      "oid": "WR-SWITCH-MIB::wrsLeapSecStatusDetails.0",
      "opcua_name": "wrsLeapSecStatusDetails",
      "opcua_type": "Enum",
      "enum": {"0": "na", "1": "ok", "2": "statusFileMissing", "3": "unknownStatus", 
        "4": "leapSecFileExpired", "5": "internalErrorDetected", "6": "taiReadError", 
        "7": "leaSecInserted", "8": "leapSecDeleted"},
      "description": "Leap second status"
    },
    {
      "oid": [
        "WR-SWITCH-MIB::wrsTempFPGA.0",
        "WR-SWITCH-MIB::wrsTempPLL.0",
        "WR-SWITCH-MIB::wrsTempPSL.0",
        "WR-SWITCH-MIB::wrsTempPSR.0"
        ],
      "opcua_name": "wrsTemperature",
      "opcua_type": "Integer32",
      "description": "Temperature readings from the White Rabbit Switch from the wrsTemperatureGroup. Elements are:\nwrsTempFPGA - FPGA temperature,\nwrsTempPLL - PLL temperature,\nwrsTempPSL - Power Supply Left (PSL) temperature,\nwrsTempPSR - Power Supply Right (PSR) temperature"
    }
  ]
}